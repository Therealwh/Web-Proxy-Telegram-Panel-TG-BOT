# =============================================================================
# TGGATE Panel — Docker-образ (опционально; основной путь — install.sh)
# Стадия 1: сборка фронтенда. Стадия 2: backend + собранная статика.
# =============================================================================

FROM node:22-alpine AS frontend-build
WORKDIR /app/frontend
COPY panel/frontend/package.json ./
RUN npm install --no-audit --no-fund
COPY panel/frontend/ ./
RUN npm run build

FROM node:22-alpine
WORKDIR /app/backend

# Зависимости backend (better-sqlite3 требует сборки на musl)
RUN apk add --no-cache python3 make g++
COPY panel/backend/package.json ./
RUN npm install --omit=dev --no-audit --no-fund

COPY panel/backend/ ./
COPY --from=frontend-build /app/frontend/dist /app/frontend/dist

EXPOSE 3000
CMD ["node", "server.js"]
