# =============================================================================
# TGGATE — Systemd-сервис Telemt (MTProto + Web Proxy)
# =============================================================================
[Unit]
Description=Telemt — Telegram MTProto/Web Proxy Server (TGGATE)
Documentation=https://github.com/telemt/telemt
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
# Запуск отдельным пользователем (безопасность)
User=telemt
Group=telemt
ExecStart=/usr/local/bin/telemt /etc/tggate/telemt.toml

# Перезапуск при падении
Restart=on-failure
RestartSec=5s

# Ограничения безопасности
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

# Telemt нужны привилегии бинда на порты < 1024? Нет (8443/18080), но оставим
# возможность на случай смены порта MTProto на 443
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Лимиты под большое число соединений
LimitNOFILE=1048576

StandardOutput=journal
StandardError=journal
SyslogIdentifier=telemt

[Install]
WantedBy=multi-user.target
