# =============================================================================
# TGGATE Backend — пример переменных окружения
# При установке install.sh генерирует заполненный .env автоматически.
# =============================================================================

NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Домен и внешний IP сервера
DOMAIN=proxy.example.com
SERVER_IP=203.0.113.10

# Секретный путь админки (генерируется при установке)
ADMIN_PATH=cp-xxxxxx

# Секрет подписи JWT (минимум 48 случайных байт)
JWT_SECRET=change-me-to-random-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Telemt Control API (только loopback)
TELEMT_API_URL=http://127.0.0.1:9091
TELEMT_API_AUTH=Bearer change-me
TELEMT_CONFIG=/etc/tggate/telemt.toml

# Пути
DB_PATH=/var/lib/tggate/tggate.db
DATA_DIR=/var/lib/tggate
BACKUP_DIR=/var/backups/tggate
LOG_DIR=/var/log/tggate

# Публичный порт MTProto
MTPROTO_PORT=8443
