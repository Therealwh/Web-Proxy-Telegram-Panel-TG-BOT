# =============================================================================
# TGGATE — Cron-задача автопроверки обновлений
# Копируется в /etc/cron.d/tggate-updates при установке.
# Частота изменяется из панели (Настройки → Обновления):
#   раз в час    : 0 * * * *
#   раз в сутки  : 0 4 * * *
#   раз в неделю : 0 4 * * 1
#   раз в месяц  : 0 4 1 * *
# =============================================================================

0 4 * * * root /usr/local/bin/tggate-check-updates >/dev/null 2>&1
